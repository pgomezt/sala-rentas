{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": ".",
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "scripts/import.ts",
    "scripts/normalize.ts",
    "scripts/operation-task.ts",
    "scripts/quality-report.ts",
    "scripts/database.ts",
    "apps/worker/src/**/*.ts",
    "packages/*/src/**/*.ts"
  ]
}
