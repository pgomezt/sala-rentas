# Copiar a .env en la raiz. Nunca subir .env a Git.
# Codificar caracteres especiales de usuario/password para una URL.
DATABASE_URL="postgresql://tornaguias_app:REEMPLAZAR_PASSWORD@127.0.0.1:5432/tornaguias_dev"
# Relativas a la raiz del proyecto; no a apps/web ni apps/worker.
SOURCE_DIRECTORY="./docs"
ORIGINALS_DIRECTORY="./data/originals"
QUARANTINE_DIRECTORY="./data/quarantine"
